<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Docker 管理概览"
        Height="860"
        Width="1500"
        MinHeight="760"
        MinWidth="1200"
        Background="#F2F4F7"
        FontFamily="Microsoft YaHei UI">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="235" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="#F7F8FA"
                BorderBrush="#D8DDE6"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="62" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Button Grid.Row="0"
                        Background="#FFFFFF"
                        BorderBrush="#D8DDE6"
                        BorderThickness="0,0,0,1"
                        Padding="18,0"
                        Cursor="Hand"
                        HorizontalContentAlignment="Left"
                        Click="AwarenessButton_OnClick">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="▦" FontSize="18" Foreground="#3C4758" VerticalAlignment="Center" />
                        <TextBlock Margin="12,0,0,0" Text="镜像和容器感知" FontSize="19" FontWeight="SemiBold" Foreground="#2F3A4A" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <StackPanel Grid.Row="1" Margin="0,10,0,0">
                    <Button Background="#FFFFFF" BorderBrush="#EBEEF3" BorderThickness="0,0,0,1" Padding="20,13" Cursor="Hand" HorizontalContentAlignment="Stretch" Click="ServiceImageButton_OnClick">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="◧" FontSize="15" Foreground="#596273" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="微服务镜像编排" FontSize="15" Foreground="#303B4A" VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <Button Background="#FFFFFF" BorderBrush="#EBEEF3" BorderThickness="0,0,0,1" Padding="20,13" Cursor="Hand" HorizontalContentAlignment="Stretch" Click="ServiceContainerButton_OnClick">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="⌁" FontSize="15" Foreground="#596273" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="微服务容器编排" FontSize="15" Foreground="#303B4A" VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <Button Background="#FFFFFF" BorderBrush="#EBEEF3" BorderThickness="0,0,0,1" Padding="20,13" Cursor="Hand" HorizontalContentAlignment="Stretch" Click="StrategyButton_OnClick">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="▣" FontSize="15" Foreground="#596273" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="容器器策略优化" FontSize="15" Foreground="#303B4A" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <UniformGrid x:Name="DashboardTopPanel" Grid.Row="0" Columns="3" Margin="0,0,0,12">
                    <Border Margin="0,0,8,0" CornerRadius="8" Padding="14" MinHeight="150" Background="#3F72D8">
                        <StackPanel>
                            <TextBlock Text="镜像" Foreground="White" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,0,-0.2,0" Width="369" />
                            <TextBlock x:Name="ImageCountText" Text="30个" Foreground="White" FontSize="42" FontWeight="Bold" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Margin="8,0" CornerRadius="8" Padding="14" MinHeight="150" Background="#2563D6">
                        <StackPanel>
                            <TextBlock Text="已启动容器" Foreground="White" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock x:Name="ContainerCountText" Text="5个" Foreground="White" FontSize="42" FontWeight="Bold" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Margin="8,0,0,0" CornerRadius="8" Padding="12" MinHeight="150" Background="#FFFFFF" BorderBrush="#DFE5EE" BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="已启动的设备：" FontSize="17" FontWeight="SemiBold" Foreground="#1F2937" VerticalAlignment="Center" />
                                <TextBlock x:Name="RunningDeviceCountText" Text="3个" FontSize="20" FontWeight="Bold" Foreground="#2563EB" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <ScrollViewer Margin="0,8,0,0" VerticalScrollBarVisibility="Auto" Height="106">
                                <StackPanel x:Name="DevicePreviewPanel" />
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border x:Name="DashboardMainPanel"
                        Grid.Row="1"
                        Background="#FFFFFF"
                        CornerRadius="8"
                        BorderBrush="#DFE5EE"
                        BorderThickness="1"
                        Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="300" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,0,8">
                            <TextBlock Text="设备：" FontSize="20" Foreground="#1F2937" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <ComboBox x:Name="DeviceSelector"
                                      Width="380"
                                      Height="30"
                                      Margin="6,0,0,0"
                                      Background="#F3F4F6"
                                      BorderBrush="#C7CDD4"
                                      BorderThickness="1"
                                      Foreground="#111827"
                                      SelectionChanged="DeviceSelector_OnSelectionChanged">
                                <ComboBox.Resources>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#F3F4F6" />
                                    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#F3F4F6" />
                                    <Style TargetType="ComboBoxItem">
                                        <Setter Property="Background" Value="#F3F4F6" />
                                        <Setter Property="Foreground" Value="#111827" />
                                        <Setter Property="Padding" Value="8,5" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Style.Triggers>
                                            <Trigger Property="IsHighlighted" Value="True">
                                                <Setter Property="Background" Value="#E5E7EB" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#D1D5DB" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ComboBox.Resources>
                            </ComboBox>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Text="资源利用率" FontSize="20" Foreground="#1F2937" FontWeight="SemiBold" Margin="0,0,0,10" />

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="330" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" Width="290" Height="290" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Canvas Width="290" Height="290">
                                    <Path x:Name="CpuSlicePath" Fill="#4F86F7" Stroke="#FFFFFF" StrokeThickness="2" Cursor="Hand" MouseEnter="PieSlice_OnMouseEnter" MouseLeftButtonUp="PieSlice_OnMouseLeftButtonUp" />
                                    <Path x:Name="MemorySlicePath" Fill="#FF7A00" Stroke="#FFFFFF" StrokeThickness="2" Cursor="Hand" MouseEnter="PieSlice_OnMouseEnter" MouseLeftButtonUp="PieSlice_OnMouseLeftButtonUp" />
                                    <Path x:Name="DiskSlicePath" Fill="#2F476B" Stroke="#FFFFFF" StrokeThickness="2" Cursor="Hand" MouseEnter="PieSlice_OnMouseEnter" MouseLeftButtonUp="PieSlice_OnMouseLeftButtonUp" />
                                </Canvas>
                                <Ellipse Width="122" Height="122" Fill="#FFFFFF" Stroke="#E5E7EB" StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="当前设备" FontSize="13" Foreground="#6B7280" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="SelectedDeviceText" Text="设备1" FontSize="17" Foreground="#111827" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Grid.Column="1" Margin="18,24,0,0">
                                <Border Background="#F1F5F9" BorderBrush="#DCE3EE" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                    <TextBlock x:Name="PieDetailText" Text="悬浮或点击饼图扇区查看详情" FontSize="14" Foreground="#334155" />
                                </Border>
                                <Border Background="#F8FAFC" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="84" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Rectangle Grid.Column="0" Width="12" Height="12" Fill="#4F86F7" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="CPU" FontSize="16" Foreground="#1F2937" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0" />
                                        <TextBlock x:Name="CpuUsageText" Grid.Column="2" Text="0.00%" FontSize="22" Foreground="#4F86F7" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                    </Grid>
                                </Border>

                                <Border Background="#F8FAFC" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="84" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Rectangle Grid.Column="0" Width="12" Height="12" Fill="#FF7A00" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="内存" FontSize="16" Foreground="#1F2937" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0" />
                                        <TextBlock x:Name="MemoryUsageText" Grid.Column="2" Text="0.00%" FontSize="22" Foreground="#FF7A00" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                    </Grid>
                                </Border>

                                <Border Background="#F8FAFC" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="84" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Rectangle Grid.Column="0" Width="12" Height="12" Fill="#2F476B" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="磁盘" FontSize="16" Foreground="#1F2937" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0" />
                                        <TextBlock x:Name="DiskUsageText" Grid.Column="2" Text="0.00%" FontSize="22" Foreground="#2F476B" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="4" BorderBrush="#E3E8EF" BorderThickness="1" CornerRadius="6" Padding="0" Background="#FFFFFF">
                            <DataGrid x:Name="DeviceImageGrid"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      RowBackground="#FFFFFF"
                                      AlternatingRowBackground="#F8FAFC"
                                      BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="镜像中文名称" Width="160" Binding="{Binding ChineseName}" />
                                    <DataGridTextColumn Header="REPOSITORY" Width="240" Binding="{Binding Repository}" />
                                    <DataGridTextColumn Header="TAG" Width="95" Binding="{Binding Tag}" />
                                    <DataGridTextColumn Header="CREATED" Width="165" Binding="{Binding Created}" />
                                    <DataGridTextColumn Header="SIZE" Width="110" Binding="{Binding Size}" />
                                    <DataGridTextColumn Header="LABELS" Width="*" Binding="{Binding Labels}" />
                                    <DataGridTextColumn Header="IMAGE ID" Width="250" Binding="{Binding ImageId}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </Border>

                <Border x:Name="StrategyPanel"
                        Grid.RowSpan="2"
                        Background="#FFFFFF"
                        CornerRadius="8"
                        BorderBrush="#D1D5DB"
                        BorderThickness="1"
                        Padding="16"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="边缘终端最大内存阈值：" FontSize="16" Foreground="#111827" VerticalAlignment="Center" />
                                <TextBox x:Name="EdgeMemoryThresholdTextBox"
                                         Width="120"
                                         Height="30"
                                         Margin="8,0,6,0"
                                         VerticalContentAlignment="Center"
                                         Text="2048" />
                                <TextBlock Text="MB" FontSize="15" Foreground="#374151" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button DockPanel.Dock="Right"
                                    Content="预部署镜像生成"
                                    MinWidth="150"
                                    Padding="18,6"
                                    Background="#111827"
                                    Foreground="White"
                                    BorderBrush="#111827"
                                    Cursor="Hand" />
                        </DockPanel>

                        <TextBlock Grid.Row="1" Text="预部署镜像：" FontSize="18" FontWeight="SemiBold" Foreground="#111827" Margin="2,0,0,8" />

                        <Border Grid.Row="2" BorderBrush="#D1D5DB" BorderThickness="1" Background="#FAFAFA">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="10">
                                <ItemsControl x:Name="StrategyImageItemsControl">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="286" Height="150" Margin="8" Padding="12" Background="White" BorderBrush="#9CA3AF" BorderThickness="1">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontSize="22" FontWeight="SemiBold" Foreground="#111827" TextTrimming="CharacterEllipsis" Margin="0,0,0,8" />
                                                    <TextBlock Text="{Binding Id, StringFormat=ID: {0}}" FontSize="16" Foreground="#1F2937" Margin="0,0,0,4" />
                                                    <TextBlock Text="{Binding Created, StringFormat=创建: {0}}" FontSize="16" Foreground="#1F2937" Margin="0,0,0,4" />
                                                    <TextBlock Text="{Binding Size, StringFormat=大小: {0}}" FontSize="16" Foreground="#1F2937" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <DockPanel Grid.Row="3" Margin="0,12,0,0">
                            <Button DockPanel.Dock="Right"
                                    Content="一键部署"
                                    MinWidth="120"
                                    Padding="18,6"
                                    Background="#E5E7EB"
                                    Foreground="#111827"
                                    BorderBrush="#9CA3AF"
                                    Cursor="Hand" />
                        </DockPanel>
                    </Grid>
                </Border>

                <Border x:Name="ServiceImagePanel"
                        Grid.RowSpan="2"
                        Background="#FFFFFF"
                        CornerRadius="8"
                        BorderBrush="#D1D5DB"
                        BorderThickness="1"
                        Padding="12"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.25*" />
                            <ColumnDefinition Width="1.1*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Column="0" Margin="0,0,10,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" BorderBrush="#9CA3AF" BorderThickness="1" CornerRadius="4" Padding="6" Background="#FCFCFD">
                                <DataGrid x:Name="SourceImageGrid"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          IsReadOnly="True"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal"
                                          RowBackground="#FFFFFF"
                                          AlternatingRowBackground="#F8FAFC"
                                          BorderThickness="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="仓库:Tag" Width="170" Binding="{Binding RepoTag}" />
                                        <DataGridTextColumn Header="镜像ID" Width="160" Binding="{Binding ImageId}" />
                                        <DataGridTextColumn Header="创建时间" Width="170" Binding="{Binding Created}" />
                                        <DataGridTextColumn Header="大小(MB)" Width="120" Binding="{Binding SizeMb}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>

                            <Border Grid.Row="2" BorderBrush="#9CA3AF" BorderThickness="1" CornerRadius="4" Padding="6" Background="#FCFCFD">
                                <DataGrid x:Name="PreparedImageGrid"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          IsReadOnly="True"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal"
                                          RowBackground="#FFFFFF"
                                          AlternatingRowBackground="#F8FAFC"
                                          BorderThickness="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="仓库:Tag" Width="170" Binding="{Binding RepoTag}" />
                                        <DataGridTextColumn Header="镜像ID" Width="160" Binding="{Binding ImageId}" />
                                        <DataGridTextColumn Header="创建时间" Width="170" Binding="{Binding Created}" />
                                        <DataGridTextColumn Header="大小(MB)" Width="120" Binding="{Binding SizeMb}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </Grid>

                        <Grid Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" BorderBrush="#9CA3AF" BorderThickness="1" CornerRadius="4" Padding="6" Background="#FCFCFD">
                                <DataGrid x:Name="ProgramFileGrid"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          IsReadOnly="True"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal"
                                          RowBackground="#FFFFFF"
                                          AlternatingRowBackground="#F8FAFC"
                                          BorderThickness="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="程序名" Width="*" Binding="{Binding Name}" />
                                        <DataGridTextColumn Header="大小" Width="120" Binding="{Binding Size}" />
                                        <DataGridTextColumn Header="修改时间" Width="170" Binding="{Binding ModifiedAt}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Top">
                                <Button Content="拷贝镜像" Height="56" Margin="0,0,0,10" Background="#E5E7EB" BorderBrush="#9CA3AF" Foreground="#111827" Cursor="Hand" />
                                <Button Content="暂存" Height="56" Margin="0,0,0,10" Background="#E5E7EB" BorderBrush="#9CA3AF" Foreground="#111827" Cursor="Hand" />
                                <Button Content="发布" Height="56" Margin="0,0,0,10" Background="#E5E7EB" BorderBrush="#9CA3AF" Foreground="#111827" Cursor="Hand" />
                                <Button Content="优化" Height="56" Background="#E5E7EB" BorderBrush="#9CA3AF" Foreground="#111827" Cursor="Hand" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Border x:Name="ServiceContainerPanel"
                        Grid.RowSpan="2"
                        Background="#FFFFFF"
                        CornerRadius="8"
                        BorderBrush="#D1D5DB"
                        BorderThickness="1"
                        Padding="12"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.ColumnSpan="2" Background="#F8FAFC" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="4" Padding="10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="选择终端" FontSize="15" Foreground="#1F2937" VerticalAlignment="Center" />
                                <ComboBox x:Name="ContainerDeviceSelector"
                                          Width="260"
                                          Height="30"
                                          Margin="10,0,0,0"
                                          Background="#F3F4F6"
                                          BorderBrush="#C7CDD4"
                                          BorderThickness="1"
                                          Foreground="#111827" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2"
                                Grid.Column="0"
                                BorderBrush="#9CA3AF"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="6"
                                Background="#FCFCFD">
                            <DataGrid x:Name="ContainerComposeGrid"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      RowBackground="#FFFFFF"
                                      AlternatingRowBackground="#F8FAFC"
                                      BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Width="190" Binding="{Binding Id}" />
                                    <DataGridTextColumn Header="名称" Width="210" Binding="{Binding Name}" />
                                    <DataGridTextColumn Header="镜像" Width="220" Binding="{Binding Image}" />
                                    <DataGridTextColumn Header="状态" Width="120" Binding="{Binding Status}" />
                                    <DataGridTextColumn Header="详情" Width="*" Binding="{Binding Detail}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Top">
                            <Button Content="刷新" Height="52" Margin="0,0,0,10" Background="#E5E7EB" BorderBrush="#9CA3AF" Foreground="#111827" Cursor="Hand" />
                            <Button Content="创建容器" Height="52" Margin="0,0,0,10" Background="#E5E7EB" BorderBrush="#9CA3AF" Foreground="#111827" Cursor="Hand" />
                            <Button Content="启动容器" Height="52" Margin="0,0,0,10" Background="#E5E7EB" BorderBrush="#9CA3AF" Foreground="#111827" Cursor="Hand" />
                            <Button Content="停止容器" Height="52" Margin="0,0,0,10" Background="#E5E7EB" BorderBrush="#9CA3AF" Foreground="#111827" Cursor="Hand" />
                            <Button Content="重启容器" Height="52" Margin="0,0,0,10" Background="#E5E7EB" BorderBrush="#9CA3AF" Foreground="#111827" Cursor="Hand" />
                            <Button Content="删除容器" Height="52" Margin="0,0,0,10" Background="#E5E7EB" BorderBrush="#9CA3AF" Foreground="#111827" Cursor="Hand" />
                            <Button Content="查看日志" Height="52" Background="#E5E7EB" BorderBrush="#9CA3AF" Foreground="#111827" Cursor="Hand" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
