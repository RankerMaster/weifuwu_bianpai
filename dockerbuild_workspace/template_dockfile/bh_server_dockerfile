FROM ubuntu:20.04

# 避免安装时区交互
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Asia/Shanghai

# 设置工作目录
WORKDIR /home

# 安装系统依赖
RUN apt-get update && apt-get install -y \
    python3.8 \
    python3.8-dev \
    python3-pip \
    gcc \
    g++ \
    gfortran \
    libopenblas-dev \
    liblapack-dev \
    && rm -rf /var/lib/apt/lists/*

RUN update-alternatives --install /usr/bin/python python /usr/bin/python3.8 1 && \
    update-alternatives --install /usr/bin/pip pip /usr/bin/pip3 1

# 升级 pip
RUN pip install --upgrade pip

#拷贝CASS引擎相关文件
COPY bond_demo_v4.tar.gz /home

RUN tar -zxvf /home/bond_demo_v4.tar.gz -C /home && \
    # ==================================================
    rm -rf /home/bond_demo_v4.tar.gz && \
# 6. 刷新系统库缓存
    ldconfig

# 安装 Python 依赖
RUN pip install --no-cache-dir -r requirements.txt

#暴露端口
#EXPOSE 3221/tcp
#EXPOSE 3222/udp

# 启动容器时自动执行 publish.sh 并保持容器终端
CMD python /home/bond_demo_v4/apiManage.py & python /home/bond_demo_v4/platManage.py
